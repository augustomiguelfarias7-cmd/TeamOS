<?xml version="1.0" encoding="utf-8"?>
<screen name="pin_creation_screen">
    <topArea>
        <text id="pinTitle" value="Crie um PIN" />
        <text id="pinSubtitle" value="Esse PIN desbloqueia o TeamOS neste dispositivo." />
    </topArea>

    <form id="pinCreationForm">
        <input
            id="pinInput"
            type="numericPassword"
            hint="Novo PIN"
            minLength="4"
            maxLength="12" />
        <input
            id="pinConfirmInput"
            type="numericPassword"
            hint="Confirmar PIN"
            minLength="4"
            maxLength="12" />
        <button
            id="finishPinButton"
            label="Entrar no TeamOS"
            action="finishPinCreation" />
    </form>
</screen>
